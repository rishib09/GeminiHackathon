# Notion Internal Integration (no OAuth required)
# 1. Create an Internal Integration at https://www.notion.so/profile/integrations
# 2. Copy the Internal Integration Secret (starts with ntn_ or secret_)
NOTION_API_KEY=ntn_your_internal_integration_secret_here

# 3. Create or open a parent page in Notion, click "..." -> Connections -> add your integration
# 4. Paste either the full Notion page URL or its 32-character page ID below
NOTION_PARENT_PAGE_ID=https://www.notion.so/your-parent-page-id

# Optional: Gemini API key for LLM binding fallback & explainer drafting
GEMINI_API_KEY=
